# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Browser origin(s) allowed to call this API. Comma-separate for more than one.
CLIENT_URL=http://localhost:4200

# ── Database (use DATABASE_URL, or the DB_* values) ──
# DATABASE_URL=postgres://user:password@host:5432/parlourbill
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=parlourbilling
DB_SSL=false

# ── Auth ─────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=45bb7b3d498199dd715761064f7efddf71440ebeff262a04e3a1031451e3e1b0f5236ecff27b510b3ce554e566acd784
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Per-IP request limits per 15 minutes: sign-in attempts, and the whole API. Raise them only to run the
# end-to-end tests, which all come from one IP:  AUTH_RATE_LIMIT=1000 API_RATE_LIMIT=5000 npm start
# AUTH_RATE_LIMIT=20
# API_RATE_LIMIT=600

# Refresh-token cookie. Use "lax" when the app and API share a site
# (app.example.com + api.example.com). Use "none" only for true cross-site hosting.
COOKIE_SAMESITE=lax

# ── Seed data (development only) ─────────────────────
# SEED_PASSWORD=

# ── WhatsApp ─────────────────────────────────────────
# Added in front of 10-digit numbers when building "Send on WhatsApp" links.
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# ── Logging ──────────────────────────────────────────
# One line per request (with a request id) and one entry per server error. Passwords, tokens and cookies are
# never written. LOG_LEVEL: debug | info | warn | error | silent   (debug also shows health checks and pre-flights)
LOG_LEVEL=info
# json = one JSON object per line (production). pretty = short readable lines. Unset: json in production, pretty otherwise.
# LOG_FORMAT=json
